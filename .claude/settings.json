{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 .claude/tools/preflight.py*)",
      "Bash(.venv/bin/python .claude/tools/corpus_run.py *)",
      "Bash(.venv/bin/python .claude/tools/docstring_coverage.py*)",
      "Bash(.venv/bin/python -m pytest*)",
      "Bash(.venv/bin/python -m coverage *)",
      "Bash(.venv/bin/python -m slopfence *)",
      "Bash(.venv/bin/pytest*)",
      "Bash(.venv/bin/coverage *)",
      "Bash(.venv/bin/slopfence *)",
      "Bash(.venv/bin/ruff check*)",
      "Bash(.venv/bin/ruff format*)",
      "Bash(npx markdownlint-cli2 *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)",
      "Bash(gh issue view *)",
      "Bash(gh issue list*)",
      "Bash(gh pr view *)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/tools/hook_session_context.py"],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/tools/hook_guard_git.py"],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/tools/hook_protect_files.py"],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/tools/hook_format_python.py"],
            "timeout": 45,
            "statusMessage": "Formatting"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/tools/hook_stop_gate.py"],
            "timeout": 300,
            "statusMessage": "Running the quick checks"
          }
        ]
      }
    ]
  }
}
